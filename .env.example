# Persistent SQLite file; the parent directory is created automatically.
GREV_DATABASE_PATH=./data/grev.sqlite

# Generate a random secret with at least 32 characters. Used only by admin APIs.
GREV_ADMIN_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Optional GitHub token for higher rate limits and access to private repositories.
GITHUB_TOKEN=

# Optional; existing GitHub OAuth sign-in remains enabled when configured.
GITHUB_ID=
GITHUB_SECRET=
AUTH_SECRET=
